# Native error destinations used by the GPL-only production acceptance cases.
interfaces:
  - type: basescape
    elements:
      - {id: errorMessage, color: 138}
      - {id: errorPalette, color: -1}
extraSprites:
  # GPL navigation fixture backdrop for the real GraphsState constructor.
