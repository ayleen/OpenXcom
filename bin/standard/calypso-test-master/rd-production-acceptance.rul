# GPL-only R&D production acceptance fragment (STR_CALYPSO_RD_PRODUCTION).
# Loaded by the harness campaign
# in addition to calypso-test-master.rul; never included in a proprietary data
# bundle.  The names are deliberately unique so this fragment cannot override
# the canonical visual fixture.

items:
  - type: STR_CALYPSO_RD_MATERIAL
    size: 1
    costBuy: 100
    costSell: 50
    transferTime: 24
  - type: STR_CALYPSO_RD_OUTPUT_A
    size: 1
    costBuy: 400
    costSell: 200
    transferTime: 24
  - type: STR_CALYPSO_RD_OUTPUT_B
    size: 1
    costBuy: 600
    costSell: 300
    transferTime: 24

crafts:
