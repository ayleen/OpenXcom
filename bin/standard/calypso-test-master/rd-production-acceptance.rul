  - type: GRAPHS.SPK
    width: 320
    height: 200
    singleImage: true
    files:
      0: Resources/calypso-hud-test-pal8.png
  - type: BACK17.SCR
    width: 320
    height: 200
    singleImage: true
    files:
      0: Resources/calypso-hud-test-pal8.png
