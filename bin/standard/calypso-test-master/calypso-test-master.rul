fontName: Font.dat

extraSprites:
  - type: CALYPSO_SPLASH_HD
    width: 640
    height: 400
    singleImage: true
    hd: true
    files:
      0: Resources/calypso-splash.png
  - type: CALYPSO_UI_PANEL_HD
    width: 480
    height: 160
    singleImage: true
    hd: true
    files:
      0: Resources/calypso-ui-panel.png
  # GPL-only Battlescape fixture resources. They intentionally reuse the
  # project-owned panel image: the regression asserts geometry, not art.
  - type: CALYPSO_HUD_PANEL
    width: 480
    height: 160
    singleImage: true
    hd: true
    files:
      0: Resources/calypso-hud-test-pal8.png
  - type: CALYPSO_HUD_PANEL_TOGGLED
    width: 480
    height: 160
    singleImage: true
    hd: true
    files:
      0: Resources/calypso-hud-test-pal8.png
  - type: ICONS.PCK
    width: 320
    height: 200
    singleImage: true
    files:
      0: Resources/calypso-hud-test-pal8.png
  - type: Touch
    width: 64
    height: 120
    subX: 32
    subY: 24
    files:
      0: Resources/calypso-hud-touch-pal8.png
  - type: KneelButton
    width: 32
    height: 32
    subX: 32
    subY: 16
    files:
      0: Resources/calypso-hud-kneel-pal8.png
  - type: Projectiles
    width: 960
    height: 320
    subX: 32
    subY: 32
    files:
      0: Resources/calypso-hud-test-pal8.png
  - type: TEST_UNIT.PCK
    width: 960
    height: 320
    subX: 32
    subY: 40
    files:
      0: Resources/calypso-hud-test-pal8.png
  - type: TEST_INVENTORYM0.SPK
    width: 320
    height: 200
    singleImage: true
    hd: true
    files:
      0: Resources/calypso-hud-test-pal8.png

extraTTFFonts:
  - id: FONT_HD_HUD
    file: Resources/oxanium-hud-test.ttf
    size: 48
  - id: FONT_F34_SAIRA_700
    file: Resources/saira-condensed-700.ttf
    size: 128
  - id: FONT_F34_MONO
    file: Resources/share-tech-mono-400.ttf
    size: 64
  # Geoscape HD v2 s.10.1 (2026-08-28): Phosphor icon face fixture for the
  # wide command rail (mirrors the hd-pack FONT_HD_ICONS registration).
  - id: FONT_HD_ICONS
    file: Resources/phosphor-regular.ttf
    size: 64
  # Command Center (mirrors the hd-pack FONT_CC_* registrations): Inter for prose and
  # IBM Plex Mono for technical copy. Static OFL faces; see font-cc/OFL-*.txt.
  - id: FONT_CC_INTER_R
    file: Resources/font-cc/Inter-Regular.ttf
    size: 64
  - id: FONT_CC_INTER_M
    file: Resources/font-cc/Inter-Medium.ttf
    size: 64
  - id: FONT_CC_INTER_SB
    file: Resources/font-cc/Inter-SemiBold.ttf
    size: 64
  - id: FONT_CC_PLEX_R
    file: Resources/font-cc/IBMPlexMono-Regular.ttf
    size: 64
  - id: FONT_CC_PLEX_M
    file: Resources/font-cc/IBMPlexMono-Medium.ttf
    size: 64
  - id: FONT_CC_PLEX_SB
    file: Resources/font-cc/IBMPlexMono-SemiBold.ttf
    size: 64
  - id: FONT_F33_BODY
    file: Resources/chakra-petch-400.ttf
    size: 64

soldiers:
  - type: STR_SOLDIER
    minStats: {tu: 50, stamina: 50, health: 30, bravery: 50, reactions: 50, firing: 50, throwing: 50, strength: 30, psiStrength: 30, psiSkill: 0, melee: 0}
    maxStats: {tu: 50, stamina: 50, health: 30, bravery: 50, reactions: 50, firing: 50, throwing: 50, strength: 30, psiStrength: 30, psiSkill: 0, melee: 0}
    statCaps: {tu: 80, stamina: 100, health: 60, bravery: 100, reactions: 100, firing: 120, throwing: 120, strength: 70, psiStrength: 100, psiSkill: 100, melee: 120}
    armor: STR_TEST_ARMOR
    standHeight: 22
    kneelHeight: 14
    soldierNames:
      - SoldierName/

armors:
  - type: STR_TEST_ARMOR
    spriteSheet: TEST_UNIT.PCK
    spriteInv: TEST_INVENTORY
    corpseBattle: [STR_TEST_CORPSE]
    frontArmor: 10
    sideArmor: 6
    rearArmor: 4
    underArmor: 4
    # The save has no tiles and never submits the unit to voxel collision. -1
    # is the explicit no-template sentinel for this geometry-only fixture.
    loftempsSet: [-1]

items:
  - type: STR_TEST_CORPSE
    weight: 20
    bigSprite: 0
    floorSprite: 0
    invWidth: 2
    invHeight: 3
    battleType: 11
    recover: false
  - type: STR_MAELSTROM_TORPEDOES
    size: 1
    costBuy: 1000
    costSell: 500
    transferTime: 24
  - type: STR_MANTIS_PROJECTOR
    size: 2
    costBuy: 2000
    costSell: 1000
    transferTime: 24
  - type: STR_ICHOR
    size: 1
    costBuy: 400
    costSell: 200
    transferTime: 24

# The normal save loader asks the active master for the ground inventory even
# when this synthetic battle contains no equipment.
invs:
  - id: STR_GROUND
    x: 0
    y: 152
    type: 2

# Small, fully redistributable ruleset fixture for the operations harness.
# Names match the native scenario selectors; no proprietary TFTD rules/assets
# are referenced.
research:
  - name: STR_MAELSTROM_BATTERY
    cost: 120
    points: 12
  - name: STR_DECANTED_CORPSE
    cost: 180
    points: 18
  - name: STR_CALYPSO_RD_LAB
    cost: 240
    points: 24
  - name: STR_CALYPSO_RD_FIELDWORK
    cost: 300
    points: 30

manufacture:
  - name: STR_MAELSTROM_TORPEDOES
    category: STR_EQUIPMENT
    space: 4
    time: 120
    cost: 1200
    requiredItems:
      STR_ICHOR: 1
  - name: STR_MANTIS_PROJECTOR
    category: STR_EQUIPMENT
    space: 6
    time: 180
    cost: 2400
    requiredItems:
      STR_ICHOR: 2

# Keep the GPL fixture self-contained when the native HD renderer resolves
# labels for the synthetic operations rules.  These keys deliberately live in
# the fixture rather than loading the production HD-pack ruleset.
extraStrings:
  - type: en-US
    strings:
      STR_CALYPSO_LABORATORY: "LABORATORY"
      STR_CALYPSO_RD_LAB: "CALYPSO LAB"
      STR_CALYPSO_RD_FIELDWORK: "FIELDWORK"
      STR_MAELSTROM_BATTERY: "MAELSTROM BATTERY"
      STR_DECANTED_CORPSE: "DECANTED CORPSE"
      STR_MAELSTROM_TORPEDOES: "MAELSTROM TORPEDOES"
      STR_MANTIS_PROJECTOR: "MANTIS PROJECTOR"
      STR_EQUIPMENT: "EQUIPMENT"
      STR_CALYPSO_RESEARCH_SCIENTISTS_AVAILABLE: "SCIENTISTS AVAILABLE"
      STR_CALYPSO_RESEARCH_SCIENTISTS_ALLOCATED: "SCIENTISTS ALLOCATED"
      STR_CALYPSO_RESEARCH_LABORATORY_SPACE_AVAILABLE: "LABORATORY SPACE AVAILABLE"
      STR_CALYPSO_RESEARCH_SCIENTISTS_ALLOCATED_UC: "SCIENTISTS ALLOCATED"
      STR_CALYPSO_RESEARCH_PROJECTS: "RESEARCH PROJECTS"
      STR_CALYPSO_ACTIVE_PROJECT_COUNT: "{0} ACTIVE"
      STR_CALYPSO_NO_ACTIVE_RESEARCH: "NO ACTIVE RESEARCH PROJECTS"
      STR_CALYPSO_START_RESEARCH_PROMPT: "Start a new project to use available laboratory capacity."
      STR_CALYPSO_RESEARCH_SELECTED_PROJECT: "SELECTED PROJECT"
      STR_NONE: "NONE"
      STR_BASES: "BASES"
      STR_SCIENTISTS_AVAILABLE: "SCIENTISTS AVAILABLE"
      STR_SCIENTISTS_ALLOCATED: "SCIENTISTS ALLOCATED"
      STR_LABORATORY_SPACE_AVAILABLE: "LABORATORY SPACE AVAILABLE"

facilities:
  - type: STR_CALYPSO_LABORATORY
    spriteShape: 1
    spriteFacility: 19
    buildCost: 1000
    buildTime: 0
    monthlyCost: 10
    labs: 10
    fireSound: -1
    hitSound: -1
    mapName: XBASES02

interfaces:
  - type: geoscape
    palette: PAL_GEOSCAPE
    elements:
      - {id: textLoad, color: 15}
      - {id: slackingIndicator, color: 15}
      - {id: trainingIndicator, color: 15}
  # Strategic navigation opens these ordinary GPL states from the real
  # Geoscape. Keep their interfaces local to the synthetic master: the HD
  # chrome owns the registered R&D forms, while these definitions only keep
  # the destination constructors from falling through to missing interfaces.
  - type: intercept
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 0}
      - {id: window, color: 133}
      - {id: text1, color: 138, color2: 208}
      - {id: text2, color: 138, color2: 208}
      - {id: list, color: 133, color2: 208, border: 138}
      - {id: disabled, color: 133}
      - {id: button, color: 133}
  - type: graphs
    backgroundImage: BACK01.SCR
    elements:
      - {id: text, color: 138}
      - {id: scale, color: 133}
      - {id: graph, color: 208}
      - {id: button, color: 133}
      - {id: regionTotal, color: 133, color2: 208}
      - {id: countryTotal, color: 133, color2: 208}
  - type: ufopaedia
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 0}
      - {id: window, color: 133}
      - {id: text, color: 138}
      - {id: list, color: 133, color2: 208, border: 138}
      - {id: listExtended, color: 133, color2: 208, border: 138}
      - {id: button1, color: 133}
      - {id: button2, color: 133}
  - type: optionsMenu
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 0}
      - {id: window, color: 133}
      - {id: tooltip, color: 133, color2: 208}
      - {id: button, color: 133}
      - {id: confirmDefaults, color: 133}
      - {id: confirmVideo, color: 133}
  - type: pauseMenu
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 0}
      - {id: window, color: 133}
      - {id: text, color: 138}
      - {id: button, color: 133}
  - type: errorMessages
    elements:
      - {id: geoscapePalette, color: 6}
      - {id: battlescapePalette, color: -1}
      - {id: geoscapeColor, color: 138}
      - {id: battlescapeColor, color: 0}
  # N05's nested ErrorMessageState keeps the real Basescape error palette and
  # color owner.  This is intentionally a tiny GPL fixture interface: the HD
  # form owns the visible presentation, while the hidden native owner still
  # needs these rule-backed elements to construct safely.
  - type: basescape
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 0}
      - {id: window, color: 133}
      - {id: text, color: 138}
      - {id: button, color: 133}
      - {id: errorMessage, color: 138}
      - {id: errorPalette, color: 6}
  - type: saveMenus
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 6}
      - {id: window, color: 133}
      - {id: text, color: 239, color2: 138}
      - {id: list, color: 138, color2: 133, border: 133}
      - {id: button, color: 133}
      - {id: confirmLoad, color: 239}
      - {id: confirmDelete, color: 138}
  - type: mainMenu
    backgroundImage: BACK01.SCR
    elements:
      - id: palette
        color: 0
      - id: window
        color: 133
      - id: text
        color: 138
      - id: button
        color: 133
      - id: battlescapeTheme
        color: 128
        color2: 128
        border: 160
  - type: newGameMenu
    backgroundImage: BACK01.SCR
    elements:
      - id: palette
        color: 0
      - id: window
        color: 133
      - id: text
        color: 138
      - id: ironman
        color: 138
      - id: button
        color: 133
  - type: battlescape
    palette: PAL_BATTLESCAPE
    elements:
      - {id: textName, color: 128}
      - {id: numTUs, color: 64}
      - {id: numEnergy, color: 16}
      - {id: numHealth, color: 32}
      - {id: numMorale, color: 192}
      - {id: barTUs, color: 64}
      - {id: barEnergy, color: 16}
      - {id: barHealth, color: 32, color2: 82}
      - {id: barMorale, color: 192}
      - {id: barMana, color: 208}
      - {id: numAmmoLeft, color: 2}
      - {id: numAmmoRight, color: 2}
      - {id: textTooltip, color: -1}
      - {id: buttonReserveNone, color: 67}
      - {id: buttonReserveSnap, color: 35}
      - {id: buttonReserveAimed, color: 35}
      - {id: buttonReserveAuto, color: 35}
      - {id: buttonReserveKneel, color: 35}
      - {id: buttonZeroTUs, color: 35}
      - id: visibleUnits
        pos: [300, -16]
        color: 16
      - {id: squadsightUnits, color: 54}
      - {id: woundedUnits, color: 134}
      - {id: passingOutUnits, color: 198}
      - id: icons
        size: [320, 56]
      - {id: numLayers, color: 15}
      - {id: warning, color: 16, color2: 32}
      - {id: messageWindows, color: -1, color2: 14, border: 7}
      - {id: thinkingProgressBar, color: 33, color2: 65, border: 1}
      - {id: medikitRed, color: 2}
      - {id: medikitGreen, color: 4}
      - {id: medikitBlue, color: 13}
      - {id: medikitOrange, color: 6}
      - {id: twoHandedRed, color: 36}
      - {id: twoHandedGreen, color: 52}

# Minimal GPL-only base/research interfaces required by the R&D harness
# constructors. The HD renderer owns the registered presentation; these
# widgets remain hidden input owners.
  - type: researchMenu
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 0}
      - {id: window, color: 133}
      - {id: text, color: 138, color2: 208}
      - {id: list, color: 133, border: 138}
      - {id: button, color: 133}
  - type: globalResearchMenu
    parent: researchMenu
    elements:
      - {id: window, color: 133}
      - {id: text, color: 138, color2: 208}
      - {id: list, color: 133, color2: 208, border: 138}
      - {id: button, color: 133}
  - type: globalResearchDiary
    parent: researchMenu
    elements:
      - {id: window, color: 133}
      - {id: text, color: 138, color2: 208}
      - {id: list, color: 133, color2: 208, border: 138}
      - {id: button, color: 133}
  - type: selectNewResearch
    parent: researchMenu
    elements:
      - {id: window, color: 133}
      - {id: text, color: 138}
      - {id: list, color: 208, color2: 133, border: 138}
      - {id: listExtended, color: 133, color2: 213}
      - {id: button, color: 133}
      - {id: button2, color: 213}
      - {id: touchButton, color: 213}
  # BuildFacilitiesState constructs this hidden native owner before the F03
  # HD adapter is registered. Keep the required GPL interface in the synthetic
  # master so setWindowBackground() cannot fail before HD readiness runs.
  - type: selectFacility
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 0}
      - {id: window, color: 133}
      - {id: button, color: 133}
      - {id: text, color: 138}
      - {id: list, color: 133, color2: 208, border: 138}
  - type: allocateResearch
    parent: researchMenu
    elements:
      - {id: window, color: 213}
      - {id: text, color: 213, color2: 208}
      - {id: button1, color: 213}
      - {id: button2, color: 133}
  - type: manufactureMenu
    backgroundImage: BACK01.SCR
    elements:
      - {id: palette, color: 0}
      - {id: window, color: 133}
      - {id: text1, color: 133, color2: 208}
      - {id: text2, color: 138}
      - {id: list, color: 133, border: 138}
      - {id: button, color: 133}
  - type: globalManufactureMenu
    parent: manufactureMenu
    elements:
      - {id: window, color: 133}
      - {id: text1, color: 133, color2: 208}
      - {id: text2, color: 138}
      - {id: list, color: 133, color2: 208, border: 138}
      - {id: button, color: 133}
  - type: selectNewManufacture
    parent: manufactureMenu
    elements:
      - {id: window, color: 133}
      - {id: text, color: 138}
      - {id: list, color: 208, color2: 133, border: 138}
      - {id: listExtended, color: 133, color2: 213}
      - {id: button, color: 133}
      - {id: button2, color: 213}
      - {id: touchButton, color: 213}
      - {id: catBox, color: 138}
  - type: allocateManufacture
    parent: manufactureMenu
    elements:
      - {id: window, color: 133}
      - {id: text, color: 133, color2: 208}
      - {id: list, color: 133, color2: 208}
      - {id: button, color: 133}
  - type: manufactureInfo
    parent: manufactureMenu
    elements:
      - {id: window, color: 138}
      - {id: text, color: 138, color2: 208}
      - {id: list, color: 133, color2: 208}
      - {id: button1, color: 138}
      - {id: button2, color: 133}
  # ManufactureDependenciesTreeState owns these hidden widgets before the
  # Calypso F10 HD adapter takes over. Keep the interface GPL-only and reuse
  # the fixture's BACK01.SCR instead of pulling the TFTD BACK13 asset.
  - type: dependencyTree
    backgroundImage: BACK01.SCR
    elements:
      - {id: window, color: 133}
      - {id: text, color: 138, color2: 208}
      - {id: list, color: 133, color2: 208, border: 138}
      - {id: button, color: 133}
  - type: techTreeViewer
    parent: researchMenu
    elements:
      - {id: window, color: 133}
      - {id: text, color: 138, color2: 208}
      - {id: list, color: 133, color2: 138, border: 133}
      - {id: listExtended, color: 208, color2: 213, border: 70}
      - {id: button, color: 133}
  - type: techTreeSelect
    parent: techTreeViewer
    elements:
      - {id: window, color: 213}
      - {id: text, color: 213, color2: 208}
      - {id: list, color: 133, color2: 138, border: 133}
      - {id: button, color: 133}

calypso_hud_overlay: true

# A deliberately unused one-cell atlas marks this synthetic master as an HD
# ruleset, causing Map::init() to register the real HUD GPU pass. The tactical
# save has no mapdatasets/tiles, so no terrain lookup depends on this fixture.
tileAtlas:
  - dataset: CALYPSO_GPL_HUD_TEST
    baseline: none
    overlayFile: Resources/calypso-ui-panel.png
    width: 960
    height: 320
    tileWidth: 960
    tileHeight: 320
    columns: 1
    frameMap:
      0: 0
